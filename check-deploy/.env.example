JWT_SECRET=<defina-um-segredo-jwt-forte>
JWT_EXPIRES_IN=12h
JWT_ISSUER=vitras-backend
JWT_AUDIENCE=vitras-client
DATA_ENCRYPTION_KEY=<defina-uma-chave-aes-256-gcm>
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5500,https://sua-app.amplifyapp.com
CORS_ALLOW_ALL=false
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX_REQUESTS=600
TWOFA_ISSUER=Vitras
TWOFA_CHALLENGE_TTL_MS=300000
TWOFA_MAX_ATTEMPTS=5
BACKUP_EXPORT_KEY=<defina-uma-chave-de-backup-segura>
ADMIN_SEED_KEY=<defina-uma-chave-de-seed-segura>
ENABLE_BACKUP_EXPORT=true
ENABLE_ADMIN_SEED=false
AUDIT_LOG_DEFAULT_LIMIT=100
AUDIT_LOG_MAX_LIMIT=500
AUDIT_LOG_RETENTION_DAYS=730
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Integracao externa para validar conselho no cadastro
# Modos:
# - off: nao consulta provedor externo
# - optional: tenta consultar, mas permite cadastro em fallback
# - required: exige resposta valida do provedor externo
COUNCIL_VERIFY_MODE=required
COUNCIL_VERIFY_PROVIDER=n8n
COUNCIL_VERIFY_URL=https://seu-provedor.com/api/verify-council
COUNCIL_VERIFY_TOKEN=<defina-token-ou-deixe-vazio-em-dev>
COUNCIL_VERIFY_TIMEOUT_MS=7000
COUNCIL_VERIFY_REQUIRE_EVIDENCE=true

# --- Hashing de pacientes ---
# Chave HMAC-SHA256 para gerar índices únicos de CPF/CNS.
# OBRIGATÓRIO em produção. Sem este valor, deduplicação por CPF/CNS não funciona.
PATIENT_LOOKUP_HASH_KEY=gere-uma-chave-aleatória-forte-32-bytes

# --- Integração laboratorial ---
# Chave de API para o endpoint público POST /integrations/lab/results.
# Se não configurado, o endpoint retorna 503.
LAB_INTEGRATION_API_KEY=gere-uma-chave-api-forte

# --- Controle de seed ---
# true = executa seed de dados demo no boot (apenas em dev/staging)
SEED_DEMO_DATA=false

# --- Controle de migrations ---
# true = executa migrations automaticamente no boot
RUN_MIGRATIONS=false

# --- Versão da aplicação ---
APP_VERSION=v1.0-pilot-governed

# --- Pruning de audit logs ---
# true = habilita pruning automático de audit logs antigos
AUDIT_PRUNE_ENABLED=false

# --- Break glass ---
# Hash bcrypt da senha do usuário break_glass_admin. Gere com: node -e "const b=require('bcryptjs');console.log(b.hashSync('SuaSenhaForte',12))"
BREAKGLASS_PASSWORD_HASH=
