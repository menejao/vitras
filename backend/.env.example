JWT_SECRET=<defina-um-segredo-jwt-forte>
JWT_EXPIRES_IN=12h
JWT_ISSUER=saudeubs-backend
JWT_AUDIENCE=saudeubs-client
DATA_ENCRYPTION_KEY=<defina-uma-chave-aes-256-gcm>
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5500,https://sua-app.amplifyapp.com
CORS_ALLOW_ALL=false
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX_REQUESTS=600
TWOFA_ISSUER=SaudeUBS
TWOFA_CHALLENGE_TTL_MS=300000
TWOFA_MAX_ATTEMPTS=5
BACKUP_EXPORT_KEY=<defina-uma-chave-de-backup-segura>
ADMIN_SEED_KEY=<defina-uma-chave-de-seed-segura>
ENABLE_BACKUP_EXPORT=true
ENABLE_ADMIN_SEED=false
AUDIT_LOG_DEFAULT_LIMIT=100
AUDIT_LOG_MAX_LIMIT=500
AUDIT_LOG_RETENTION_DAYS=730
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Integracao externa para validar conselho no cadastro
# Modos:
# - off: nao consulta provedor externo
# - optional: tenta consultar, mas permite cadastro em fallback
# - required: exige resposta valida do provedor externo
COUNCIL_VERIFY_MODE=required
COUNCIL_VERIFY_PROVIDER=n8n
COUNCIL_VERIFY_URL=https://seu-provedor.com/api/verify-council
COUNCIL_VERIFY_TOKEN=<defina-token-ou-deixe-vazio-em-dev>
COUNCIL_VERIFY_TIMEOUT_MS=7000
COUNCIL_VERIFY_REQUIRE_EVIDENCE=true
